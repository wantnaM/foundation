# 复制为 .env.local 后填写；不要提交真实账号密码。
# 本地 PostgreSQL 示例，密码中的特殊字符需要进行 URL 编码。
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/foundation
# 每个应用进程最多保持的数据库连接数。
DATABASE_POOL_MAX=50

# AI 基座日志设置。
LOG_LEVEL=info
LOG_FORMAT=text
# LLM_THINKING_DISABLED=true

# 服务端 AI：沿用 OpenMAIC 的配置名称，密钥放在 .env.local，不要填入此示例。
DEFAULT_MODEL=deepseek:deepseek-flash
DEEPSEEK_API_KEY=
# 可选，留空时使用模型清单内的官方地址。
DEEPSEEK_BASE_URL=
# 可选，限制允许使用的模型，多个名称以逗号分隔。
DEEPSEEK_MODELS=
# 可选，默认读取项目根目录的 server-providers.yml。
# SERVER_PROVIDERS_FILE=
